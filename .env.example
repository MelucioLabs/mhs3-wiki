# ============================================
# MHS3 Wiki - Environment Configuration
# ============================================
# Copy this file to .env and adjust values
# cp .env.example .env

# --- Database (PostgreSQL) ---
DB_HOST=postgres          # Docker service name (don't change for Docker)
DB_PORT=5432              # Default PostgreSQL port
DB_USER=mhs3_user         # Database username
DB_PASSWORD=changeme123   # CHANGE THIS in production!
DB_NAME=mhs3_wiki         # Database name

# --- pgAdmin ---
PGADMIN_EMAIL=admin@mhs3wiki.com      # pgAdmin login email
PGADMIN_PASSWORD=pgadmin_changeme    # CHANGE THIS in production!

# --- Application ---
APP_PORT=3000             # Pi: 3000 | EC2: 3000 (behind nginx: 80/443)
NODE_ENV=production       # development | production

# --- Platform Notes ---
# Raspberry Pi 4/5: These defaults work fine. Keep APP_PORT=3000.
# AWS EC2:          Use a strong DB_PASSWORD, set NODE_ENV=production,
#                   and put nginx in front for SSL termination.
